APP_NAME=AI Knowledge Backend
APP_ENV=development
APP_DEBUG=true

API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ai_knowledge
REDIS_URL=redis://redis:6379/0

JWT_SECRET_KEY=development-only-secret-change-before-deploy
JWT_ALGORITHM=HS256
JWT_ISSUER=ai-knowledge-platform
JWT_AUDIENCE=ai-knowledge-api
ACCESS_TOKEN_EXPIRE_MINUTES=60

LLM_PROVIDER=mock
LLM_MODEL=mock-model
LLM_BASE_URL=http://ollama:11434

EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=mock-embedding-model

VECTOR_STORE=pgvector
